# InChat 환경 설정 예시 — `npm run setup` 을 실행하면 이 파일을 .env 로 복사하고 비밀값을 자동 생성합니다.
# .env 는 Git 에 올리지 마세요 (.gitignore 에 포함되어 있습니다).

# ── 네트워크 ─────────────────────────────────────────
# 0.0.0.0: 같은 Wi-Fi/LAN 의 다른 기기에서 접속 가능 / 127.0.0.1: 이 컴퓨터에서만 접속
HOST=0.0.0.0
PORT=3000

# HTTPS (다른 기기에서 화면 공유를 하려면 필요). 먼저 `npm run cert` 로 인증서를 만드세요.
HTTPS=false
HTTPS_PORT=3443
# CERT_DIR=./certs

# ── 데이터 ───────────────────────────────────────────
DB_PATH=./data/inchat.sqlite

# ── 보안 ─────────────────────────────────────────────
# 같은 Origin 은 항상 허용됩니다. 그 외에 허용할 Origin 을 쉼표로 나열 (예: https://chat.example.com)
ALLOWED_ORIGINS=
# 서버 관리자 코드: 화면 프로필 메뉴의 "서버 관리자 인증"에 입력하면 기본 채널(전체 채팅 등)도 관리/방송할 수 있습니다.
# 비워 두면 기능이 꺼집니다. `npm run setup` 이 무작위 값을 채워 줍니다.
ADMIN_CODE=
# 강퇴 시 IP 도 함께 차단할지 (기본 false). 켜면 같은 PC/공유기 뒤의 다른 사용자도 막힐 수 있습니다.
BAN_BY_IP=false
# 비워 두면 DB 에 무작위 값이 저장됩니다. (IP 해시용 비밀값)
IP_HASH_SECRET=
SESSION_TTL_DAYS=30

# ── 방송(WebRTC) ─────────────────────────────────────
# 같은 LAN 안에서는 STUN 이 필요 없습니다. 외부 STUN 을 쓰려면 쉼표로 나열 (예: stun:stun.l.google.com:19302)
STUN_URLS=
# 방송 시청자 수 한도. 방송자가 시청자마다 영상을 보내므로 인원이 늘면 시청자당 화질을 자동으로 낮춥니다.
# (방송자 PC 성능/Wi-Fi 에 따라 실제 가능한 인원은 다릅니다. 20명 규모는 아래 README 의 검증 범위를 참고)
MAX_VIEWERS_PER_BROADCAST=20

# ── 제한(선택) ───────────────────────────────────────
# MESSAGE_MAX_LENGTH=500
# MSG_BURST=5
# MSG_REFILL_MS=1000
# MSG_MIN_GAP_MS=300
# HTTP_RATE_PER_MINUTE=300
# LEAVE_GRACE_MS=4000
